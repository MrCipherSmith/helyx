{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-orchestrator-output-contract",
  "title": "Job Orchestrator Output Contract",
  "description": "Defines the structure of the final report and PR proposal produced by job-orchestrator.",
  "type": "object",
  "required": ["format", "structure"],
  "properties": {
    "format": {
      "type": "string",
      "const": "markdown",
      "description": "Output is in Markdown format (not Gherkin — this is the top-level human-readable report)"
    },
    "structure": {
      "type": "object",
      "description": "Structure of the implementation report",
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Summary",
              "Analysis",
              "Tasks",
              "Review Results",
              "Unresolved Issues",
              "Final Checks",
              "Skill Updates",
              "Metrics",
              "Execution Metrics",
              "Changes Summary",
              "PR Proposal"
            ]
          },
          "description": "Sections in the report. The enum matches the template in SKILL.md 2.9 — it was closed at seven values and excluded two sections the skill instructs the orchestrator to emit, so a conforming report was unrepresentable."
        }
      }
    },
    "report_fields": {
      "type": "object",
      "description": "Key fields in the report for programmatic access",
      "properties": {
        "summary": {
          "type": "object",
          "properties": {
            "issue_number": { "type": "integer" },
            "issue_title": { "type": "string" },
            "issue_type": { "type": "string" },
            "branch_name": { "type": "string" },
            "tasks_completed": { "type": "integer" },
            "tasks_total": { "type": "integer" },
            "review_rounds": {
              "type": "integer",
              "description": "Managed review rounds run — each one has a package under .metaproject/reviews/."
            },
            "final_status": {
              "type": "string",
              "enum": ["READY FOR PR", "HAS WARNINGS", "HAS ISSUES", "ANALYSIS ONLY", "FAILED"]
            }
          }
        },
        "task_results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": { "type": "string" },
              "task_name": { "type": "string" },
              "status": { "type": "string", "enum": ["success", "partial", "failed"] },
              "files": { "type": "array", "items": { "type": "string" } },
              "commits": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "review_results": {
          "type": "array",
          "description": "Per-reviewer counts, in the canonical severity vocabulary of review-finding.schema.json. The old critical/warning/info triple could not be populated from findings the reviewers actually produce.",
          "items": {
            "type": "object",
            "properties": {
              "reviewer": { "type": "string" },
              "review_id": { "type": "string", "description": "The managed review package this round was ingested into." },
              "blocker": { "type": "integer" },
              "major": { "type": "integer" },
              "minor": { "type": "integer" },
              "info": { "type": "integer" }
            }
          }
        },
        "dispositions": {
          "type": "object",
          "description": "Terminal disposition counts recorded by `keryx review complete`. `unknown` above zero means findings were closed without anyone writing down what happened to them.",
          "properties": {
            "unknown": { "type": "integer" },
            "acted-on": { "type": "integer" },
            "dismissed-incorrect": { "type": "integer" },
            "dismissed-wont-fix": { "type": "integer" },
            "dismissed-out-of-scope": { "type": "integer" },
            "dismissed-deprioritised": { "type": "integer" }
          }
        },
        "final_checks": {
          "type": "object",
          "properties": {
            "lint": { "type": "string" },
            "type_check": { "type": "string" },
            "tests": { "type": "string" }
          }
        },
        "pr_data": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "base": { "type": "string" },
            "head": { "type": "string" },
            "draft": { "type": "boolean" },
            "body": { "type": "string" }
          }
        }
      }
    }
  }
}
