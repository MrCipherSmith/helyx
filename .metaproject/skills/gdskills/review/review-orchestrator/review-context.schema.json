{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-context",
  "title": "Review Context Pack",
  "type": "object",
  "required": [
    "request",
    "scope",
    "routing",
    "token_policy"
  ],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": true
    },
    "git": {
      "type": "object",
      "additionalProperties": true
    },
    "pr": {
      "type": [
        "object",
        "null"
      ],
      "description": "The pull request under review, when there is one. `body` is the author's own statement of what the change does, and it is checkable against the diff — it is typed here rather than left to convention because the Context Pack prose told reviewers to read `pr.body` while the schema declared no such field, so nothing carried it and nothing could tell a body that was never fetched from one that was empty.",
      "properties": {
        "number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "description": "Fetched, not assumed: `gh pr view <n> --json title,body`. Null means the fetch did not happen or returned nothing; an empty string means the author wrote no description, which is a different fact and a reportable one."
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "open",
            "merged",
            "closed",
            null
          ]
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": [
        "mode",
        "files"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "diff",
            "path"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_lines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "risk_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cross_repo": {
      "type": "array",
      "description": "Contracts owned by another service that this diff consumes — a payload shape, a status enum, a timeout, a permission, a default. Each entry is one reading of the producer, shared by every reviewer, so that a later round can tell a contract that moved from a reviewer that misread it. An entry is a RECORD OF READING: an unavailable producer is a result and belongs here as `state: unavailable`, whereas an assumed one belongs nowhere.",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "reason",
          "facts",
          "state"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "What this diff needs from the producer, in one line."
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "What the producer actually says, read at the pinned ref. A claim about another service's behaviour with no `file:line` behind it at a pinned ref is `info`, not `major`, however confident — both failure modes are recorded: a finding the producer disproves, and a defect missed because the producer's real default was assumed rather than read."
          },
          "state": {
            "type": "string",
            "enum": [
              "merged",
              "open",
              "unavailable"
            ],
            "description": "Where the contract lives right now. `merged` is on the producer's own base branch and is pinned by `sha`. `open` is a parallel pull request that has not landed: its branch will be rebased or squashed, so a sha pinned today names a commit that will not exist after the merge, and the contract itself can still change. `unavailable` means the producer could not be read."
          },
          "sha": {
            "type": [
              "string",
              "null"
            ],
            "description": "The commit the facts were read at. Required when `state` is `merged`."
          },
          "pr": {
            "type": [
              "string",
              "null"
            ],
            "description": "The producer's pull request, when the contract is not merged yet."
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "merge_order": {
            "type": "string",
            "enum": [
              "producer_first",
              "consumer_first",
              "independent",
              "unknown"
            ],
            "default": "unknown",
            "description": "Which side has to ship first for production to stay correct. `producer_first` on a `state: open` entry is the case where merging THIS change first breaks production, and it is a blocker rather than the `minor` filed for a missing deploy note."
          },
          "facts_pinned_round": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The review round the facts were read in."
          },
          "revalidated_round": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The last round the producer was re-read. An entry with `state: open` that was pinned in round 1 and never revalidated is stale by round 3: a parallel pull request is precisely the thing that moves between rounds."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "merged"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "required": [
                "sha"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "open"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "required": [
                "pr"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "query",
        "entries"
      ],
      "description": "Result of the accepted-memory search the Context Pack step runs against the changed paths. Recorded here rather than only inlined into reviewer prompts so that a round which found NO relevant memory is distinguishable from a round that never searched.",
      "properties": {
        "query": {
          "type": "string",
          "description": "What was searched, so the search can be reproduced."
        },
        "status_filter": {
          "type": "string",
          "enum": [
            "accepted"
          ],
          "default": "accepted",
          "description": "Only accepted memory may be inlined. A draft entry is a hypothesis; presenting one to a reviewer as project truth turns a wrong hypothesis into a wrong finding."
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "title"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "searched": {
          "type": "boolean",
          "default": true,
          "description": "False only when the memory module is disabled. An empty `entries` with `searched: true` means the search ran and matched nothing."
        }
      },
      "additionalProperties": true
    },
    "routing": {
      "type": "object",
      "required": [
        "selected_reviewers"
      ],
      "properties": {
        "selected_reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped_reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "token_policy": {
      "type": "object",
      "required": [
        "context_mode",
        "omissions"
      ],
      "properties": {
        "context_mode": {
          "type": "string",
          "enum": [
            "none",
            "light",
            "full"
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": true
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_plan": {
          "type": "object",
          "description": "Detected model capabilities and chosen strategy for review sub-agents.",
          "properties": {
            "detector_ran": {
              "type": "boolean"
            },
            "strategy": {
              "type": "string",
              "enum": [
                "ask",
                "adaptive"
              ]
            },
            "current_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "complex_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "normal_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "simple_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "user_confirmed_expensive_fanout": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "review_plan": {
      "type": "object",
      "description": "Grouped reviewer plan shown before optional reviewer prompts.",
      "properties": {
        "already_selected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional_convention_detected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reviewer",
              "reason"
            ],
            "properties": {
              "reviewer": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "enable_with": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "optional_legacy_profile_available": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_legacy_profile": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dispatch_plan": {
          "type": "array",
          "description": "Per-reviewer runtime dispatch decision for native agent compatibility.",
          "items": {
            "type": "object",
            "required": [
              "reviewer",
              "runtime"
            ],
            "properties": {
              "reviewer": {
                "type": "string"
              },
              "runtime": {
                "type": "string",
                "enum": [
                  "native-agent",
                  "general-purpose-fallback",
                  "blocked"
                ]
              },
              "agent_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "skill_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "publication_plan": {
          "type": "object",
          "description": "User-confirmed PR review report publication mode and generated artifact metadata.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "ask",
                "comment",
                "comment-and-ai-artifact",
                "none"
              ]
            },
            "pr_number": {
              "type": [
                "integer",
                "null"
              ]
            },
            "pr_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "comment_posted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "ai_artifact_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "ai_artifact_link": {
              "type": [
                "string",
                "null"
              ]
            },
            "user_confirmed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
