{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer-finding",
  "title": "Reviewer Result and Findings",
  "type": "object",
  "required": [
    "status",
    "reviewer",
    "summary",
    "findings",
    "stats"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "DONE_WITH_CONCERNS",
        "NEEDS_CONTEXT",
        "BLOCKED"
      ]
    },
    "reviewer": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "problem",
          "impact",
          "suggested_fix",
          "evidence",
          "confidence",
          "reviewer"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "info"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "problem": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reviewer": {
            "type": "string"
          },
          "dedupe_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "blocking_merge": {
            "type": "boolean",
            "default": false
          },
          "class_scope": {
            "title": "Every site of this shape, and how the set was derived",
            "description": "A finding anchored to one file:line is a claim about one site. Repeatedly, a fix repaired that site and left its siblings — one writer of five, one operator instruction of four, six readers of eight — and the next review round found them. Required for blocker and major; optional below, because enumerating the class for every info finding is theatre. Kept identical to src/gdskills/contracts/review-finding.schema.json, which is stricter (additionalProperties: false) and would reject this property if it were declared only here.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sites",
              "enumeration_method"
            ],
            "properties": {
              "sites": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Every location carrying the shape, including ones already correct. A single-entry list is a claim that the class has one member."
              },
              "enumeration_method": {
                "type": "string",
                "minLength": 1,
                "description": "How the set was derived: the grep or query run, the source-level guard that enumerates it, or why the list is exhaustive. 'I checked the others' is not a method."
              }
            }
          }
        },
        "additionalProperties": true,
        "if": {
          "required": [
            "severity"
          ],
          "properties": {
            "severity": {
              "enum": [
                "blocker",
                "major"
              ]
            }
          }
        },
        "then": {
          "required": [
            "class_scope"
          ]
        }
      }
    },
    "needs_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "blocker",
        "major",
        "minor",
        "info"
      ],
      "properties": {
        "blocker": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
