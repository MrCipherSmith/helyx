{
  "name": "helyx",
  "version": "1.55.1",
  "description": "Telegram bot that turns your phone into a Claude Code control panel — approve terminal commands, monitor multiple projects in forum topics, talk hands-free via voice",
  "keywords": ["telegram", "claude", "claude-code", "ai", "bot", "mcp", "voice", "typescript", "bun"],
  "repository": {
    "type": "git",
    "url": "https://github.com/MrCipherSmith/helyx.git"
  },
  "homepage": "https://github.com/MrCipherSmith/helyx#readme",
  "author": "MrCipherSmith",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun main.ts",
    "dev": "bun --watch main.ts",
    "migrate": "bun memory/db.ts",
    "cli": "bun cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit/",
    "test:unit": "bun test tests/unit/",
    "test:e2e": "cd tests && npx playwright test --config=playwright.config.ts",
    "test:e2e:api": "cd tests && npx playwright test --config=playwright.config.ts --project=api",
    "test:e2e:dashboard": "cd tests && npx playwright test --config=playwright.config.ts --project=dashboard",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov tests/unit/ && bun scripts/coverage-summary.ts",
    "health": "bun run test:coverage && keryx test run && keryx health run",
    "dupes": "bun scripts/find-duplicate-definitions.ts",
    "cleanup:dry-run": "DRY_RUN=true bun cleanup/runner.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "grammy": "^1.44.0",
    "kokoro-js": "^1.2.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
